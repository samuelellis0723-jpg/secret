{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@pages/*": ["./src/pages/*"],
      "@routing/*": ["./src/routing/*"],
      "@services/*": ["./src/services/*"],
      "@context/*": ["./src/context/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"]
}

