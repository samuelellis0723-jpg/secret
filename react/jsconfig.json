{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@pages/*": ["src/pages/*"],
      "@features/*": ["src/features/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"]
}
